# Copy to .env and fill in. Used by the Netlify functions (netlify dev reads
# .env) and by `npm run voice:generate`. Never commit .env.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id

# AI dispatcher wording (Hugging Face Inference Providers), used by
# netlify/functions/dispatch.mts. Create a token at
# https://huggingface.co/settings/tokens with "Make calls to Inference
# Providers" permission. HF_MODEL is optional.
HF_TOKEN=your-hugging-face-token
HF_MODEL=google/gemma-4-26B-A4B-it

# Optional: transcribe push-to-talk with ElevenLabs Scribe (uses credits on
# every transmission) instead of the browser's free speech recognition.
# VITE_ELEVENLABS_STT=true
